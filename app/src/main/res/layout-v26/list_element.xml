<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/layoutName"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:layout_marginHorizontal="1dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/viewName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:lines="1"
            android:gravity="center_vertical"
            android:text="@string/unknown"
            android:textColor="?android:textColorPrimary" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp"
            android:textSize="18sp"
            android:textColor="?android:textColorPrimary"
            android:text=""
            android:inputType="text"
            android:maxLines="1"
            android:visibility="gone"
            android:hint="@string/enter_server_name"
            android:autofillHints="@string/enter_server_name" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:layout_marginHorizontal="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/viewAddr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:lines="1"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:textColor="?android:textColorPrimary" />

        <EditText
            android:id="@+id/editAddr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp"
            android:textSize="18sp"
            android:textColor="?android:textColorPrimary"
            android:text=""
            android:inputType="text"
            android:maxLines="1"
            android:visibility="gone"
            android:hint="@string/enter_server_addr"
            android:autofillHints="@string/enter_server_addr" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/delBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_delete"
        android:layout_marginStart="6dp"
        android:layout_marginVertical="8dp"
        android:background="#00000000"
        android:contentDescription="@string/delete" />
</LinearLayout>